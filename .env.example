ALPACA_API_KEY_ID=...          # stock prices (APCA_API_KEY_ID also works)
ALPACA_API_SECRET_KEY=...      # (APCA_API_SECRET_KEY also works)
ALPACA_DATA_FEED=sip           # sip = consolidated tape (free plan: data > 15 min old) | iex
# Paper trading (python -m jevbt paper): paper-account keys; the data keys above are used if unset.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
FMP_API_KEY=...                # fundamentals (statements, company profile/peers)
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_DAILY_BUDGET=240
FMP_STATEMENT_LIMIT=5
OPENAI_API_KEY=sk-...
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_FULL=gpt-4.1
TYPESAFE_BASE_URL=https://openrouter.ai/api
TYPESAFE_API_KEY=sk-or-...   # OpenRouter key; OPENROUTER_API_KEY is used if this is not set
JEV_MODEL=typesafe/jev-1.13
